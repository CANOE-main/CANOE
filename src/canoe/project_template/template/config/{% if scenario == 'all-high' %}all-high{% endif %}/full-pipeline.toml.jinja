# ####################################################################################
# {{ project_name }}: scenario {{ scenario }}
# ####################################################################################
# Relative paths in this file (and in the TOMLs of sectors/) are relative to the
# folder of the file they are written in. Run from the project folder:
#   uv run main.py
#   uv run canoe run config/{{ scenario }}/full-pipeline.toml

# Databases built by the pipeline (the compiled one and its reduced copy)
working_directory = "../../canoe-pwd/{{ scenario }}"

# ####################################################################################
# COMPILER CONFIG
# ####################################################################################
[compiler.base]
db_output_dir = "../../canoe-pwd/{{ scenario }}/canoe.sqlite"
# Version in the data set codes (e.g. COMHR003), inherited by the sectors
data_version = "003"
existing_periods = [
  1970,
  1975,
  1980,
  1985,
  1990,
  1995,
  2000,
  2005,
  2010,
  2015,
  2020,
  2022,
  2024,
]
# Model periods, the ones the modules write data for. The end of the horizon
# (last period + period_step, here 2050) is added to time_period with no data
future_periods = [2025, 2030, 2035, 2040, 2045]
period_step = 5
provinces = {{ provinces | tojson }}
global_discount_rate = 0.03

# Projected GDP and population that grow the sector demands, inherited by the sectors.
# gdp: { source = "cer", scenario = ... } with scenario "Global Net-zero", "Canada
# Net-zero" or "Current Measures" (national), or { source = "csv", path = ... }.
# population: { source = "statcan" } (by province) or { source = "csv", path = ... }.
# A CSV has the columns region, year, value and optionally source; a region that is
# empty, "Canada" or "CA" is national and applies to the provinces without rows of
# their own.
gdp = { source = "cer", scenario = "Global Net-zero" }
population = { source = "statcan" }
# demand_projection_point: "period_end", "period_start" or "legacy"
demand_projection_point = "period_end"

# Year of each period at which projected prices (e.g. fuel prices) are read, inherited
# by the modules: "period_end" or "period_start"
price_projection_point = "period_end"

# Year of the Canadian dollars model costs are written in, inherited by the modules
model_currency_year = 2020

# Emission commodities (CO2, CH4, N2O and CO2e) are always registered
# [compiler.base.emissions]
# gwp = "AR5-100"          # weights of the gases in the CO2e rows
# cost_of_co2e = 0.1       # cost of CO2e emissions in every region and model period
# cost_units = "M$/ktCO2e"

# ####################################################################################
# DATA CACHE
# ####################################################################################
# Local copy of the CANOE data lake: `uv run canoe cache install <folder>`. The
# snapshot (cache_date) is the one this version of canoe was tested with.
[compiler.base.data_cache_config]
cache_dir = {{ cache_dir | tojson }}
cache_date = "2026-08-10"

# ####################################################################################
# END-USE SECTORS
# ####################################################################################
# One TOML per sector; leave a sector out (or comment it) to skip it
[compiler.sectors]
commercial = "sectors/commercial.toml"
agriculture = "sectors/agriculture.toml"
industry = "sectors/industry.toml"
residential = "sectors/residential.toml"

# Ghost of a sector whose end-use tree is added to the database after the pipeline
# runs: its fuels are registered (e.g. T_elc) and supplied by the electricity and
# fuel modules, and the tree takes them as input. One module per sector.
# [compiler.sectors.transportation]
# module_name = "ghost"
# sector = "TRP"                  # by name or code
# fuels = ["ELC", "GSL", "DSL"]
# dataset_code_description = "HR"  # e.g. HR in TRPHR003

# ####################################################################################
# ELECTRICITY
# ####################################################################################
# Electricity supply of the sectors (E_<S>_ELC) and the grid behind it; runs after the
# sectors, and its generators' fuels are supplied by the fuel module
[compiler.electricity]
config_file = "sectors/electricity.toml"

# ####################################################################################
# FUELS
# ####################################################################################
# Fuel supply of the fuels the sectors import (electricity is left to the electricity
# module): an import technology F_IMP_<FUEL> per fuel and a distribution technology
# F_<S>_<FUEL> per consuming sector.
[compiler.fuel]
# Sources of the delivered fuel prices, in priority order: "eia" (EIA AEO delivered
# prices by sector and fuel, US average), "atb" (NREL ATB biomass and uranium),
# "fixed" (report prices of ethanol, renewable diesel and SPK), or "csv" with the
# path of your own price file, e.g. { source = "csv", path = "my_prices.csv" }.
price_sources = [{ source = "eia" }, { source = "atb" }, { source = "fixed" }]
# How the sources share the prices: each (region, sector, fuel) from the first source
# that has it ("per_series"), or each fuel from the first source that prices it
# ("per_fuel")
price_fallback = "per_series"
# "error" or "warning"
validation_behavior = "error"  # database lacks periods, regions or commodities
missing_data_behavior = "warning"  # a fuel imported by a sector has no price or emission factors

# ####################################################################################
# REPRESENTATIVE PERIODS
# ####################################################################################
# Reduce the database to representative days before running Temoa
[representative_periods_config]
# What the reduced database keeps of each demand: "hourly" values of the
# representative days (the annual demand changes) or the "annual" demand
demand_preservation = "hourly"
# Share of each demand's distribution set to zero, from its smallest values
dsd_threshold = 0.01

# The days of a clustering packaged with canoe (2018 weather, 6 principal components)
[representative_periods_config.clustering]
kind = "tsam_collection"
collection = "weather2018-hierarchical-pca6"
# Representative days, forced days included
n_periods = 16
# Days added as representative days
forced_days = ["D041"]

# ####################################################################################
# TEMOA
# ####################################################################################
[temoa_config]
# Gurobi needs a license for a model this size (free for academics); "appsi_highs"
# is open source (slower, and set save_duals = false with it)
solver = "gurobi"
# "perfect_foresight" solves the model; "build_only" only builds it
scenario_mode = "perfect_foresight"
output_path = "../../temoa-outputs/{{ scenario }}"
silent = false
save_duals = true
